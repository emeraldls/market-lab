# syntax=docker/dockerfile:1.7
FROM rust:bookworm AS builder

ARG MLAB_VOLUME_INGEST_URL
ARG MLAB_VOLUME_INGEST_KEY
ENV MLAB_VOLUME_INGEST_URL=${MLAB_VOLUME_INGEST_URL}
ENV MLAB_VOLUME_INGEST_KEY=${MLAB_VOLUME_INGEST_KEY}

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --locked --release --bin mlabd && \
    cp /src/target/release/mlabd /tmp/mlabd

FROM gcr.io/distroless/python3-debian12:nonroot

LABEL org.opencontainers.image.source="https://github.com/emeraldls/market-lab"
LABEL org.opencontainers.image.description="Isolated Market Lab daemon runtime"

COPY --from=builder /tmp/mlabd /usr/local/bin/mlabd
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /usr/local/bin/

USER nonroot:nonroot
WORKDIR /home/marketlab
ENV HOME=/home/marketlab
ENV UV_CACHE_DIR=/home/marketlab/.market-lab/cache/uv
ENV UV_PYTHON_INSTALL_DIR=/home/marketlab/.market-lab/python

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD ["/usr/local/bin/mlabd", "healthcheck"]

ENTRYPOINT ["/usr/local/bin/mlabd"]
CMD ["serve"]
